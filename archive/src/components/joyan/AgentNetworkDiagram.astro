---
import { cn } from '~/lib/utils';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<!--
  Abstract agent-network diagram (spec: magi section MUST include an abstract
  diagram and MUST NOT include product screenshots). Decorative: the copy
  conveys the meaning, so the SVG is hidden from assistive tech.
-->
<svg
  viewBox="0 0 480 300"
  aria-hidden="true"
  class={cn('block h-auto w-full border border-hairline bg-ink-900', className)}
>
  <!-- inner orbit -->
  <circle cx="240" cy="150" r="84" class="stroke-hairline" fill="none" stroke-dasharray="2 7"></circle>
  <!-- edges to satellite agents: opacity-only energy pulse -->
  <line x1="240" y1="150" x2="390" y2="150" class="stroke-hairline edge-pulse"></line>
  <line x1="240" y1="150" x2="315" y2="72" class="stroke-hairline edge-pulse"></line>
  <line x1="240" y1="150" x2="165" y2="72" class="stroke-hairline edge-pulse"></line>
  <line x1="240" y1="150" x2="90" y2="150" class="stroke-hairline edge-pulse"></line>
  <line x1="240" y1="150" x2="165" y2="228" class="stroke-hairline edge-pulse" stroke-dasharray="3 4"></line>
  <line x1="240" y1="150" x2="315" y2="228" class="stroke-hairline edge-pulse"></line>
  <!-- satellite agent nodes -->
  <circle cx="390" cy="150" r="11" class="fill-ink-800 stroke-hairline"></circle>
  <circle cx="315" cy="72" r="11" class="fill-ink-800 stroke-hairline"></circle>
  <circle cx="165" cy="72" r="11" class="fill-ink-800 stroke-hairline"></circle>
  <circle cx="90" cy="150" r="11" class="fill-ink-800 stroke-hairline"></circle>
  <circle cx="165" cy="228" r="11" class="fill-ink-800 stroke-accent"></circle>
  <circle cx="315" cy="228" r="11" class="fill-ink-800 stroke-hairline"></circle>
  <!-- central node: MAGI -->
  <circle cx="240" cy="150" r="52" class="fill-accent"></circle>
  <text
    x="240"
    y="150"
    text-anchor="middle"
    dominant-baseline="central"
    class="fill-accent-ink font-mono text-sm font-bold tracking-widest"
  >
    MAGI
  </text>
</svg>
