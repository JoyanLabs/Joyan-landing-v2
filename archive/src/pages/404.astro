---
import Layout from '~/layouts/Layout.astro';
import { getHomePermalink } from '~/utils/permalinks';
import { es, LOCALES } from '~/lib/i18n';

// 404 pages are client errors: excluded from indexing and crawling.
const title = 'Página no encontrada';
const content = es;
---

<Layout
  lang={LOCALES.ES}
  metadata={{
    title,
    description: content.meta.description,
    robots: { index: false, follow: false },
  }}
>
  <div class="flex min-h-screen items-center bg-ink-950 text-bone-100">
    <div class="mx-auto max-w-3xl px-6 py-24 text-center">
      <p class="font-mono text-xs uppercase tracking-widest text-plomo-400">Joyan — Error</p>
      <h1 class="mt-6 text-display text-8xl text-bone-50">404</h1>
      <p class="mt-6 text-2xl font-medium text-bone-100">Página no encontrada</p>
      <p class="mx-auto mt-4 max-w-md leading-relaxed text-plomo-400">La página que buscas no existe o fue movida.</p>
      <a
        href={getHomePermalink()}
        class="mt-10 inline-block bg-accent px-6 py-3 font-mono text-xs uppercase tracking-widest text-accent-ink transition-opacity hover:opacity-90"
      >
        Volver al inicio
      </a>
    </div>
  </div>
</Layout>
