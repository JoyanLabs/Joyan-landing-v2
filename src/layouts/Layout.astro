---
import '~/assets/styles/tailwind.css';

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';
import { I18N } from 'joyanlabs:config';
import CustomStyles from '~/components/CustomStyles.astro';
import Analytics from '~/components/common/Analytics.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';
import CommonMeta from '~/components/common/CommonMeta.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Favicons from '~/components/Favicons.astro';

import type { MetaData as MetaDataType } from '~/types';
import { JOURNAL_ROUTES, LOCALES } from '~/lib/i18n';
import { resolveJournalLocaleCluster } from '~/utils/journal';
import { getCanonical } from '~/utils/permalinks';

export interface Props {
  metadata?: MetaDataType;
  lang?: string;
  /** Current page pathname — selects the canonical/hreflang locale cluster. */
  pathname?: string;
}

const { metadata = {}, lang = I18N.language, pathname = '/' } = Astro.props;
const { textDirection } = I18N;

// Layout owns the path-aware canonical/hreflang cluster (docs/DESIGN.md):
// landings alternate `/` ↔ `/en`; journal archives alternate `/bitacora` ↔
// `/en/log` with x-default pointing at the ES archive; paired details
// alternate their REAL counterparts; an ES-only detail emits only its
// self-canonical — no alternate, not even x-default. Canonical itself is
// always the absolute self URL (Metadata component).
const cluster = await resolveJournalLocaleCluster(pathname);

let hreflangHrefs: Record<string, string> | null = null;
if (cluster.kind === 'landing') {
  hreflangHrefs = {
    [LOCALES.ES]: String(getCanonical('/')),
    [LOCALES.EN]: String(getCanonical('/en')),
  };
} else if (cluster.kind === 'archive') {
  hreflangHrefs = {
    [LOCALES.ES]: String(getCanonical(JOURNAL_ROUTES[LOCALES.ES])),
    [LOCALES.EN]: String(getCanonical(JOURNAL_ROUTES[LOCALES.EN])),
  };
} else if (cluster.alternatePath) {
  const esPath = cluster.locale === LOCALES.ES ? pathname : cluster.alternatePath;
  const enPath = cluster.locale === LOCALES.EN ? pathname : cluster.alternatePath;
  hreflangHrefs = {
    [LOCALES.ES]: String(getCanonical(esPath)),
    [LOCALES.EN]: String(getCanonical(enPath)),
  };
}
---

<!doctype html>
<html lang={lang} dir={textDirection} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} lang={lang} />
    {
      Object.entries(hreflangHrefs ?? {}).map(([locale, href]) => (
        <link rel="alternate" hreflang={locale} href={href} />
      ))
    }
    {hreflangHrefs && <link rel="alternate" hreflang="x-default" href={hreflangHrefs[LOCALES.ES]} />}
    <SiteVerification />
    <Analytics />

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight">
    <slot />

    <BasicScripts />
  </body>
</html>
