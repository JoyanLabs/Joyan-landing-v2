---
import Layout from '~/layouts/Layout.astro';
import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  lang?: string;
}

const { metadata, lang } = Astro.props;
---

<Layout metadata={metadata} lang={lang}>
  <div class="bg-ink-950 text-bone-100">
    <slot name="header" />
    <main class="relative">
      <slot />
    </main>
    <slot name="footer" />
  </div>
</Layout>
