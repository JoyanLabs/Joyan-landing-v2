---
import PageLayout from '~/layouts/PageLayout.astro';
import SiteHeader from '~/components/joyan/SiteHeader.astro';
import SiteFooter from '~/components/joyan/SiteFooter.astro';
import SectionHeader from '~/components/joyan/SectionHeader.astro';
import JournalEntryRow from '~/components/joyan/JournalEntryRow.astro';
import { es, LOCALES } from '~/lib/i18n';
import { getPublishedJournal } from '~/utils/journal';

const content = es;
const journal = content.journal;
const entries = await getPublishedJournal(LOCALES.ES);
const pathname = Astro.url.pathname;
---

<PageLayout
  lang={LOCALES.ES}
  metadata={{ title: journal.archive.title, description: journal.archive.description }}
  pathname={pathname}
>
  <SiteHeader slot="header" locale={LOCALES.ES} nav={content.nav} path={pathname} />
  <!-- id="top": keeps the logo/footer home anchors working on the archive -->
  <section id="top" class="mx-auto max-w-6xl px-6 py-24">
    <!-- headingLevel=1: the archive is a standalone page — its only title is
         the single h1; rows render h2 (titleLevel=2) so no level is skipped. -->
    <SectionHeader index={journal.index} kicker={journal.kicker} title={journal.title} headingLevel={1} />
    <p class="mt-8 max-w-2xl text-lg leading-relaxed text-bone-100">{journal.lead}</p>
    {
      entries.length > 0 ? (
        <ul class="mt-14">
          {entries.map((entry) => (
            <JournalEntryRow entry={entry} content={journal} titleLevel={2} locale={LOCALES.ES} linkMode="archive" />
          ))}
        </ul>
      ) : (
        <p class="mt-14 border-t border-hairline pt-8 font-mono text-xs uppercase tracking-widest text-plomo-400">
          {journal.emptyState}
        </p>
      )
    }
  </section>
  <SiteFooter slot="footer" content={content.footer} nav={content.nav} locale={LOCALES.ES} path={pathname} />
</PageLayout>
