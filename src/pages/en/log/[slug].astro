---
import { render } from 'astro:content';
import JournalDetailPage from '~/components/joyan/JournalDetailPage.astro';
import { en, LOCALES } from '~/lib/i18n';
import { getPublishedJournalRouteRecords, type JournalRouteRecord } from '~/utils/journal';

export interface Props {
  record: JournalRouteRecord;
}

/**
 * EN journal detail: one static page per published EN entry at
 * `/en/log/{slug}`. Published EN entries always pair with a published ES
 * entry (ES-authoritative); draft and unknown slugs never build.
 */
export async function getStaticPaths() {
  const records = await getPublishedJournalRouteRecords(LOCALES.EN);
  return records.map((record) => ({
    params: { slug: record.entry.data.slug },
    props: { record },
  }));
}

const { record } = Astro.props;
const { entry } = record;
const { Content } = await render(entry);
const pathname = Astro.url.pathname;
---

<JournalDetailPage entry={record.entry} locale={LOCALES.EN} content={en} pathname={pathname}>
  <Content />
</JournalDetailPage>
