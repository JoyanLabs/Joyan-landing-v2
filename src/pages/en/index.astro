---
/**
 * WU22 — the single coming-soon page (EN). Same contract as the ES page:
 * the full-bleed autoplaying unicorn hero (build-time conversion, tone cap,
 * roll, page palette, data-URI bake), short and mysterious placeholder copy
 * pending branding review (shipped option and alternatives recorded in the
 * tracking document), real metadata, and the / ↔ /en hreflang pair owned by
 * the layout. The attribution lives in docs/MOTOR-ESCENAS.md, not on the page.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import JoyanComingHero from '~/components/joyan/JoyanComingHero.astro';
import { en, LOCALES } from '~/lib/i18n';
import { convert } from '../../../scripts/scene-src/from-image.mjs';
import { applyTreatment } from '../../../scripts/scene-src/overlays.mjs';
import {
  serializeScene, sceneFromSerialized, rollSerializedScene, PAGE_PALETTE_ID, IMAGE_PALETTES,
} from '../../../scripts/scene-src/image-pipeline.mjs';
import { LOCAL_INPUTS } from '../../../scripts/scene-src/local-inputs.mjs';
import { renderFrame, rasterize, DELIVERY_CELL } from '../../../scripts/scene-src/engine.mjs';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import sharp from 'sharp';

const pathname = Astro.url.pathname;

// The hero recipe. The subject is composed centre-right (roll +18 columns) so
// the text region of the full-bleed layout stays over dark ground.
const HERO_ROLL = 18;
const HERO_OVERLAYS = ['stars', 'aurora', 'wash'];

const HERO_FIXTURE = resolve('dist-motion-verify/wu18/input/blade-runner-unicorn-line-transparent.svg');
const heroHasFixture = existsSync(HERO_FIXTURE);
const heroConverted = await convert(
  heroHasFixture ? HERO_FIXTURE : (LOCAL_INPUTS.find((entry) => entry.id === 'joyan-mark')?.svg ?? ''),
  {
    cols: 160, rows: 80, mode: 'ink', colorMode: 'levels', palette: 'ink',
    id: 'joyan-coming-hero',
    label: heroHasFixture
      ? 'the coming-hero — based on the Blade Runner unicorn, design attributed to Tom Southwell (demonstration; attribution recorded in docs/MOTOR-ESCENAS.md)'
      : 'the Joyan mark — ring, two triangles, axis and dots',
  },
);
// The rolled, treated serialisation is the ONE payload the runtime receives, so
// the live canvas draws exactly the placed scene the Node bake produces.
const heroRolledPayload = rollSerializedScene(serializeScene(heroConverted.scene), HERO_ROLL);
const heroScene = applyTreatment(
  sceneFromSerialized(heroRolledPayload),
  { palette: PAGE_PALETTE_ID, overlays: HERO_OVERLAYS },
  IMAGE_PALETTES,
);
const payload = JSON.stringify(serializeScene(heroScene));

// The no-JS still is the build-time bake of the SAME scene, embedded as a data
// URI; the committed mark poster is only the fallback for builds without the art.
let poster: string;
if (heroHasFixture) {
  const frame = renderFrame(heroScene, heroScene.posterFrame, { dither: 'bayer4', density: 1 });
  const rgba = rasterize(frame, heroScene, DELIVERY_CELL);
  const png = await sharp(Buffer.from(rgba), { raw: { width: frame.cols * DELIVERY_CELL, height: frame.rows * DELIVERY_CELL, channels: 4 } })
    .png({ compressionLevel: 9, adaptiveFiltering: false })
    .toBuffer();
  poster = `data:image/png;base64,${png.toString('base64')}`;
} else {
  poster = '/assets/dither/coming-hero.png';
}

// Placeholder copy pending branding review (recorded in the tracking document).
const content = en;
---

<PageLayout
  lang={LOCALES.EN}
  metadata={{
    title: content.meta.title,
    description: 'Joyan. Something precise is taking shape.',
    robots: { index: true, follow: true },
  }}
  pathname={pathname}
>
  <div class="flex min-h-dvh flex-col bg-ink-950 font-sans text-bone-100 antialiased">
    <JoyanComingHero
      poster={poster}
      payload={payload}
      palette={PAGE_PALETTE_ID}
      overlays={HERO_OVERLAYS.join(',')}
      name="Joyan"
      tagline="Something precise is taking shape."
      comingSoon="Coming soon"
      footerNote="© Joyan — built with care."
      contactEmail="hello@joyan.dev"
      discordLabel="Discord — the invite is coming soon"
    />
  </div>
</PageLayout>
