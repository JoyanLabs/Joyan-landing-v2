---
import Layout from '~/layouts/PageLayout.astro';
import ContactForm from '~/components/joyan/ContactForm.vue';

const metadata = {
  title: 'Contacto - Joyan',
};
---

<Layout metadata={metadata}>
  <section class="relative pt-32 pb-12 text-center z-10">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl md:text-6xl font-bold mb-6">
        Hablemos de <span class="text-secondary">Futuro</span>
      </h1>
      <p class="text-xl text-muted max-w-3xl mx-auto">
        El primer paso para resolver la complejidad es una conversación simple.
      </p>
    </div>
  </section>

  <ContactForm client:visible />
</Layout>
