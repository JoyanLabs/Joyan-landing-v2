---
import PageLayout from '~/layouts/PageLayout.astro';
import SiteHeader from '~/components/joyan/SiteHeader.astro';
import Hero from '~/components/joyan/Hero.astro';
import AgentsSection from '~/components/joyan/AgentsSection.astro';
import MagiSection from '~/components/joyan/MagiSection.astro';
import HardwareSection from '~/components/joyan/HardwareSection.astro';
import EcosystemSection from '~/components/joyan/EcosystemSection.astro';
import JournalSection from '~/components/joyan/JournalSection.astro';
import SiteFooter from '~/components/joyan/SiteFooter.astro';
import { es, LOCALES } from '~/lib/i18n';

const content = es;
const pathname = Astro.url.pathname;
---

<PageLayout
  lang={LOCALES.ES}
  metadata={{ title: content.meta.title, description: content.meta.description }}
  pathname={pathname}
>
  <SiteHeader slot="header" locale={LOCALES.ES} nav={content.nav} path={pathname} />
  <Hero content={content.hero} />
  <AgentsSection content={content.agents} />
  <MagiSection content={content.magi} />
  <HardwareSection content={content.hardware} />
  <EcosystemSection content={content.ecosystem} />
  <JournalSection locale={LOCALES.ES} content={content.journal} />
  <SiteFooter slot="footer" content={content.footer} nav={content.nav} locale={LOCALES.ES} path={pathname} />
</PageLayout>

<script>
  import { animate, inView } from 'framer-motion/dom';

  // Scroll reveals (docs/DESIGN.md — Motion guide): below-hero sections fade
  // and rise once on first viewport entry. Server markup stays visible and
  // static (no-JS and reduced-motion keep it that way); this script only
  // animates opacity and transform. The pre-reveal hidden state is a CSS
  // class (opacity/transform-only, in tailwind.css) — never inline style
  // attributes. Every inView cleanup and animation control is stored so
  // astro:before-swap can release it before the DOM swap and astro:page-load
  // can reinitialize after it.

  const REDUCED_MOTION_QUERY = '(prefers-reduced-motion: reduce)';
  const REVEAL_PENDING_CLASS = 'is-reveal-pending';

  const cleanups: Array<() => void> = [];
  const controls: Array<{ stop: () => void }> = [];

  function clearAll(): void {
    for (const control of controls) control.stop();
    for (const cleanup of cleanups) cleanup();
    controls.length = 0;
    cleanups.length = 0;
  }

  function init(): void {
    clearAll();
    if (window.matchMedia(REDUCED_MOTION_QUERY).matches) return;
    const elements = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
    for (const element of elements) {
      element.classList.add(REVEAL_PENDING_CLASS);
      const stopInView = inView(
        element,
        () => {
          element.classList.remove(REVEAL_PENDING_CLASS);
          const control = animate(element, { opacity: 1, y: 0 }, { duration: 0.65, ease: 'easeOut' });
          controls.push(control);
          return () => control.stop();
        },
        { margin: '0px 0px -12% 0px', amount: 0.2 }
      );
      cleanups.push(stopInView);
    }
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', clearAll);
  init();
</script>
