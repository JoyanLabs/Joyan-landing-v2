---
/**
 * WU20 (correction round) — the single coming-soon page (ES).
 *
 * The hero subject is the Blade Runner unicorn the user supplied, by their
 * explicit on-the-record direction (they consider it an open-source-style
 * illustration based on the film design and direct using it "para probar").
 * The conversion and the poster bake happen HERE, in Node, at build time from
 * the gitignored local fixture: the SVG never enters the repository, and only
 * the converted serialisation and the baked PNG travel as data. When the
 * fixture is absent (any other machine), the hero falls back to our mark so
 * the build never depends on the art.
 *
 * The hero autoplays (user-directed); the copy is PLACEHOLDER pending branding
 * review — recorded in the tracking document, not shown to visitors.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import JoyanComingHero from '~/components/joyan/JoyanComingHero.astro';
import { es, LOCALES } from '~/lib/i18n';
import { convert } from '../../scripts/scene-src/from-image.mjs';
import { applyTreatment } from '../../scripts/scene-src/overlays.mjs';
import { serializeScene, IMAGE_PALETTES } from '../../scripts/scene-src/image-pipeline.mjs';
import { LOCAL_INPUTS } from '../../scripts/scene-src/local-inputs.mjs';
import { renderFrame, rasterize, DELIVERY_CELL } from '../../scripts/scene-src/engine.mjs';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import sharp from 'sharp';

const pathname = Astro.url.pathname;

// The hero recipe (docs/MOTOR-ESCENAS.md — coming-hero): the supplied film-prop
// line art, ink measurement at 160 × 80, the deep aurora image palette,
// stars + aurora overlays, the engine's own five-rung ladder and bayer4 dither
// at the 8 px delivery pitch.
const HERO_FIXTURE = resolve('dist-motion-verify/wu18/input/blade-runner-unicorn-line-transparent.svg');
const heroHasFixture = existsSync(HERO_FIXTURE);
const heroConverted = await convert(
  heroHasFixture ? HERO_FIXTURE : (LOCAL_INPUTS.find((entry) => entry.id === 'joyan-mark')?.svg ?? ''),
  {
    cols: 160, rows: 80, mode: 'ink', colorMode: 'levels', palette: 'ink',
    id: 'joyan-coming-hero',
    label: heroHasFixture
      ? 'the coming-hero — based on the Blade Runner unicorn, design attributed to Tom Southwell (demonstration)'
      : 'the Joyan mark — ring, two triangles, axis and dots',
  },
);
const heroScene = applyTreatment(heroConverted.scene, { palette: 'aurora', overlays: ['stars', 'aurora'] }, IMAGE_PALETTES);
const payload = JSON.stringify(serializeScene(heroScene));

// The no-JS still is the build-time bake of the SAME scene. With the local
// fixture present it is embedded as a data URI (never a committed derivative);
// the committed mark poster is only the fallback for builds without the art.
let poster: string;
if (heroHasFixture) {
  const frame = renderFrame(heroScene, heroScene.posterFrame, { dither: 'bayer4', density: 1 });
  const rgba = rasterize(frame, heroScene, DELIVERY_CELL);
  const png = await sharp(Buffer.from(rgba), { raw: { width: frame.cols * DELIVERY_CELL, height: frame.rows * DELIVERY_CELL, channels: 4 } })
    .png({ compressionLevel: 9, adaptiveFiltering: false })
    .toBuffer();
  poster = `data:image/png;base64,${png.toString('base64')}`;
} else {
  poster = '/assets/dither/coming-hero.png';
}

// Placeholder copy pending branding review (recorded in the tracking document).
const content = es;
const attribution = heroHasFixture
  ? 'El hero está basado en el unicornio de Blade Runner, diseño atribuido a Tom Southwell — usado como demostración a petición expresa del usuario. Su uso en producción requiere derechos confirmados.'
  : 'El hero usa nuestra marca propia; la demostración del unicornio requiere el fichero local.';
---

<PageLayout
  lang={LOCALES.ES}
  metadata={{
    title: content.meta.title,
    description:
      'Diseñamos agentes que trabajan dentro de límites acordados y sistemas conectados que registran lo que ocurre en el mundo físico, para que cada operación sea auditable y revisable. Joyan — próximamente.',
    robots: { index: true, follow: true },
  }}
  pathname={pathname}
>
  <div class="flex min-h-dvh flex-col bg-ink-950 font-sans text-bone-100 antialiased">
    <div class="flex flex-1 flex-col items-center justify-center">
      <JoyanComingHero
        poster={poster}
        payload={payload}
        palette="aurora"
        overlays="stars,aurora"
        name="Joyan"
        tagline="Diseñamos agentes que trabajan dentro de límites acordados y sistemas conectados que registran lo que ocurre en el mundo físico, para que cada operación sea auditable y revisable."
        values={['Agentes que operan dentro de límites acordados', 'Registro auditable de cada acción', 'Revisión humana en las decisiones que importan']}
        comingSoon="Estamos construyendo algo nuevo"
        attribution={attribution}
      />
    </div>
    <footer class="border-t border-hairline">
      <div class="mx-auto flex w-full max-w-6xl flex-col gap-1 px-4 py-6 text-xs text-plomo-400 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <p>© Joyan — construido con criterio.</p>
        <p class="font-mono">Sitio en construcción · volveremos pronto.</p>
      </div>
    </footer>
  </div>
</PageLayout>
