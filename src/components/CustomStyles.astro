---
import "@fontsource-variable/inter";

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: #3A4E8C;
    --aw-color-secondary: #5B7FBB;
    --aw-color-accent: #A1C6E7;

    --aw-color-text-heading: #1D1F2C;
    --aw-color-text-default: rgb(16 16 16);
    --aw-color-text-muted: rgb(16 16 16 / 66%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: #1D1F2C;

    --aw-color-primary: rgb(71 85 105);
    --aw-color-secondary: rgb(15 23 42);
    --aw-color-accent: rgb(109 40 217);

    ::selection {
      background-color: lavender;
    }

    /* Joyan Light Mode */
    --joyan-bg: #ffffff; /* Pure white background */
    --joyan-card: rgba(255, 255, 255, 0.7); /* Translucent white for glass effect */
    --joyan-accent: #4b4e6d;
    --joyan-muted: #4b4e6d; /* Darker muted text for readability */
    --joyan-text: #0b0c1d; /* Darkest brand color for main text */
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: #A1C6E7;
    --aw-color-secondary: #5B7FBB;
    --aw-color-accent: #3A4E8C;

    --aw-color-text-heading: #F0F4FF;
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(3 6 32);

    --aw-color-primary: rgb(71 85 105);
    --aw-color-secondary: rgb(15 23 42);
    --aw-color-accent: rgb(109 40 217);

    ::selection {
      background-color: black;
      color: snow;
    }

    /* Joyan Dark Mode */
    --joyan-bg: #0b0c1d;
    --joyan-card: #2c2e4a;
    --joyan-accent: #4b4e6d;
    --joyan-muted: #7a7d9d;
    --joyan-text: #b7b9d9;
  }
</style>
