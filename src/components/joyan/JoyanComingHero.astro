---
/**
 * WU29 — the public sequence hero. The user's direction: the page STARTS ON
 * PURE BLACK — no scene, no poster, no eyebrow — with only the terminal typing
 * "Wake up, Neo…" (VT323, bone text, amber prompt, no green); the engine's own
 * warp ramp then transforms the black into the unicorn scene (the SAME
 * payload, grid, joyan-page palette and stars/aurora/wash overlays, driven by
 * `~/lib/public-sequence` — the ONE runtime path on the public pages — so the
 * dots the visitor ends up watching are the same dots this page always
 * rendered, and the settled state is byte-identical to it). The fate line then
 * takes the tagline slot with its TERMINATOR 2 · SARAH CONNOR credit, corrupts
 * through our dot-ramp glyphs (· • ●, plomo/bone/amber — never unicode noise)
 * and re-forms into the watcher line, which stays.
 *
 * The black start is a JS-GATED STATE (the WU28 lesson at section level): the
 * inline script below sets `data-sequence-boot="js"` BEFORE first paint, and
 * the scoped CSS shows the black state only under that attribute. Without
 * scripting the attribute never appears — the server markup IS the final
 * state (poster, eyebrow, name, watcher line), never black. Reduced motion
 * skips the intro and the scramble (and the boot CSS shows the final state
 * under prefers-reduced-motion too, so even the pre-mount frame is truthful).
 *
 * The ES/EN switch is a real link pair in the top corner (each page links to
 * the other locale; no JS). No other controls: the hero autoplays (WU20).
 * The eyebrow is the shipped choice "TRANSMISIÓN"/"TRANSMISSION" (alternatives
 * recorded in odd/tasks/dither-iteration.md and docs/DESIGN.md).
 */
interface Props {
  /** Build-time baked poster PNG of the scene's poster frame (data URI or asset path). */
  poster: string;
  /** The pipeline's own serialisation of the converted scene, as JSON text. */
  payload: string;
  /** The image-palette id and overlay ids the treatment applies. */
  palette?: string;
  overlays?: string;
  name: string;
  /** The shipped eyebrow (WU29: "TRANSMISIÓN" / "TRANSMISSION"). */
  eyebrow: string;
  /** The fate line — the first tagline-slot phrase after the reveal. */
  fateLine: string;
  /** The watcher line — the final phrase, also the no-JS/reduced content. */
  watcherLine: string;
  credit: string;
  /** The other locale's path and label for the corner link pair. */
  localeHref: string;
  localeLabel: string;
  footerNote: string;
  contactEmail: string;
  discordUrl?: string;
  discordLabel: string;
}
const {
  poster, payload, palette = 'joyan-page', overlays = 'stars,aurora,wash', name, eyebrow, fateLine, watcherLine,
  credit, localeHref, localeLabel, footerNote, contactEmail, discordUrl = '', discordLabel,
} = Astro.props;

/**
 * DISCORD_INVITE_URL (WU22) — the future Discord invite lives HERE, in one
 * clearly named constant. The user will configure it later; until then the
 * mark renders without a link (no invented URL is ever shipped).
 */
const DISCORD_INVITE_URL = '';
const discordHref = discordUrl || DISCORD_INVITE_URL;

/**
 * The Discord mark, authored in OUR aesthetic: the Clyde silhouette laid out on
 * a 16 × 10 dot grid and drawn as round dots — the same dot language as the
 * scene. `#` is one dot; the eyes are the empty 2 × 2 gaps.
 */
const DISCORD_DOT_GRID = Object.freeze([
  '....########....',
  '..############..',
  '.##############.',
  '####..####..####',
  '####..####..####',
  '####..####..####',
  '.##############.',
  '..############..',
  '...##########...',
  '..###......###..',
]);
const dotRows = DISCORD_DOT_GRID.length;
const dotCols = DISCORD_DOT_GRID[0].length;
---

<section
  data-coming-hero
  data-hero-autoplay
  data-hero-palette={palette}
  data-hero-overlays={overlays}
  class="relative flex min-h-[88dvh] w-full flex-col overflow-hidden bg-ink-950"
  aria-labelledby="coming-hero-name"
>
  {/* WU29 — the scripting marker: set BEFORE first paint, so the black act-1
      state is only ever reachable when scripting actually runs. Without it the
      server markup is the final state (never black). */}
  <script is:inline>
    (function () {
      const section = document.currentScript && document.currentScript.parentElement;
      if (section) section.setAttribute('data-sequence-boot', 'js');
    })();
  </script>
  {/* The scene layer: hidden (black) under the JS boot state, revealed by the
      engine's own warp ramp. The no-JS still is the build-time poster. */}
  <div class="scene-layer absolute inset-0" aria-hidden="true">
    <img
      src={poster}
      alt=""
      data-hero-poster
      width="1280"
      height="640"
      loading="eager"
      decoding="async"
      class="block h-full w-full object-cover"
    />
    <canvas class="block h-full w-full object-cover"></canvas>
  </div>
  {/* Measured scrim: the text region stays dark no matter what the scene does. */}
  <div class="scrim absolute inset-0" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto flex w-full max-w-6xl flex-1 flex-col px-4 sm:px-6">
    <div class="mt-[14dvh] max-w-xl">
      <p data-hero-eyebrow class="font-mono text-xs uppercase tracking-[0.3em] text-accent">{eyebrow}</p>
      {/* WU31 — the name arrives WITH the reveal, assembled out of the dot
          ramp glyphs by the runtime. During act 1 it is fully hidden (the
          boot CSS empties it); the aria-label keeps the accessible name
          stable so screen readers never read the scramble. */}
      <h1 id="coming-hero-name" data-hero-name class="font-display mt-4 text-5xl tracking-tight text-bone-50 sm:text-7xl" aria-label={name}>{name}</h1>
      {/* The tagline slot: the terminal types here on black; after the reveal
          the fate line takes it, corrupts through our dot-ramp glyphs and
          re-forms into the watcher line (the SSR content = the final phrase,
          which is what no-JS and reduced motion show). */}
      <div data-hero-terminal class="terminal mt-6" aria-hidden="true">
        <p class="text-bone-50">
          <span class="text-accent">&gt;</span>
          <span data-hero-typed data-hero-terminal-text="Wake up, Neo…"> </span><span class="caret"></span>
        </p>
      </div>
      <p
        data-hero-tagline
        data-hero-fate={fateLine}
        data-hero-watcher={watcherLine}
        class="mt-6 max-w-md text-lg leading-relaxed text-bone-100"
      >{watcherLine}</p>
      <p data-hero-credit class="hero-credit mt-4 font-mono text-xs uppercase tracking-[0.24em] text-accent">{credit}</p>
    </div>
    <p data-hero-status class="sr-only" role="status">
      Static poster
    </p>
  </div>
  {/* WU29 — the ES/EN switch is a real link pair: each page links to the
      other locale. No JS, no other control (the hero autoplays, WU20). */}
  <nav data-hero-locale aria-label="Language / Idioma" class="absolute top-4 right-4 z-20 sm:top-6 sm:right-6">
    <a
      href={localeHref}
      hreflang={localeLabel === 'EN' ? 'en' : 'es'}
      lang={localeLabel === 'EN' ? 'en' : 'es'}
      class="font-mono text-xs uppercase tracking-[0.3em] text-bone-100 underline decoration-hairline underline-offset-4 transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-accent"
    >{localeLabel}</a>
  </nav>
  <script is:inline type="application/json" data-coming-hero-scene set:html={payload} />
</section>

<footer class="relative z-10 border-t border-hairline bg-ink-950">
  <div
    class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 py-8 sm:flex-row sm:items-center sm:justify-between sm:px-6"
  >
    <div class="flex items-center gap-4">
      {/* The dot rule: the page's own aesthetic carried into the footer. */}
      <svg
        aria-hidden="true"
        viewBox="0 0 104 8"
        width="104"
        height="8"
        class="shrink-0 text-plomo-500"
      >
        {[0, 1, 2, 3, 4, 5, 6].map((index) => (
          <circle cx={4 + index * 16} cy="4" r={index % 2 === 0 ? 3 : 2} fill="currentColor" />
        ))}
      </svg>
      <p class="text-xs text-plomo-400">{footerNote}</p>
    </div>
    <div class="flex items-center gap-6">
      <a
        href={`mailto:${contactEmail}`}
        class="font-mono text-sm text-bone-100 underline decoration-hairline underline-offset-4 transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-accent"
      >
        {contactEmail}
      </a>
      {discordHref ? (
        <a
          href={discordHref}
          rel="noopener"
          aria-label={discordLabel}
          title={discordLabel}
          class="text-bone-100 transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-accent"
        >
          <svg
            viewBox={`0 0 ${dotCols} ${dotRows}`}
            width="28"
            height="18"
            role="img"
            aria-hidden="true"
            class="block"
          >
            {DISCORD_DOT_GRID.map((row, y) =>
              [...row].map((cell, x) =>
                cell === '#' ? <circle cx={x + 0.5} cy={y + 0.5} r="0.44" fill="currentColor" /> : null
              )
            )}
          </svg>
        </a>
      ) : (
        <span
          aria-label={discordLabel}
          title={discordLabel}
          class="text-plomo-400"
          data-discord-mark
        >
          <svg
            viewBox={`0 0 ${dotCols} ${dotRows}`}
            width="28"
            height="18"
            role="img"
            aria-hidden="true"
            class="block"
          >
            {DISCORD_DOT_GRID.map((row, y) =>
              [...row].map((cell, x) =>
                cell === '#' ? <circle cx={x + 0.5} cy={y + 0.5} r="0.44" fill="currentColor" /> : null
              )
            )}
          </svg>
        </span>
      )}
    </div>
  </div>
</footer>

<script>
  // The ONE runtime import on the public page: the public sequence runtime,
  // driving the black start, the engine reveal and the corrupted text arc.
  import '~/lib/public-sequence';
</script>

<style>
  .scene-layer {
    display: grid;
    /* The layer's opacity is driven by the runtime's ramp (style.opacity);
       the boot state starts it at black. */
    transition: none;
  }
  /* The baked poster is the no-JS still; the canvas takes over on load. */
  [data-coming-hero] canvas {
    display: none;
  }
  [data-coming-hero][data-playing] canvas {
    display: block;
  }
  [data-coming-hero][data-playing] [data-hero-poster] {
    display: none;
  }

  /* ---- WU29 boot states ---------------------------------------------------
     data-sequence-boot="js" is set by the inline script BEFORE first paint, so
     the black act-1 state exists only when scripting actually runs. Without
     the attribute (no JS) nothing here applies: the server markup IS the
     final state — poster, eyebrow, name, watcher line — never black. */
  [data-coming-hero][data-sequence-boot='js']:not([data-ready]) .scene-layer {
    opacity: 0;
  }
  [data-coming-hero][data-sequence-boot='js']:not([data-ready]) [data-hero-eyebrow] {
    opacity: 0;
  }
  [data-coming-hero][data-sequence-boot='js']:not([data-ready]) [data-hero-tagline] {
    opacity: 0;
  }
  [data-coming-hero][data-sequence-boot='js']:not([data-ready]) [data-hero-credit] {
    opacity: 0;
  }
  /* WU31 — act 1 contains NOTHING but the terminal: the name h1 is emptied
     too (pixel-proven at 100/400/800 ms). */
  [data-coming-hero][data-sequence-boot='js']:not([data-ready]) [data-hero-name] {
    opacity: 0;
  }
  [data-coming-hero][data-sequence-boot='js']:not([data-ready]) [data-hero-terminal] {
    opacity: 1;
  }
  [data-coming-hero] [data-hero-terminal] {
    opacity: 0;
  }
  /* During the typing phase the runtime mounts and the boot rule stops; the
     phase attribute keeps the black-act composition (terminal on, copy off,
     SCENE LAYER OFF — the page sits on pure black until the reveal). */
  [data-coming-hero][data-sequence-phase='typing'] .scene-layer {
    opacity: 0;
  }
  [data-coming-hero][data-sequence-phase='typing'] [data-hero-terminal] {
    opacity: 1;
  }
  [data-coming-hero][data-sequence-phase='typing'] [data-hero-eyebrow],
  [data-coming-hero][data-sequence-phase='typing'] [data-hero-tagline],
  [data-coming-hero][data-sequence-phase='typing'] [data-hero-credit] {
    opacity: 0;
  }
  /* ---- WU31 phase-gated copy --------------------------------------------
     With scripting, the copy is hidden by DEFAULT and every rule that shows
     it names its phase: the name and eyebrow arrive at the reveal (the name
     assembles through the dot-ramp glyphs), the watcher line exists ONLY
     from the fate phase on — it can never surface while the terminal types
     or during the reveal. The credit rides with the fate line and leaves
     with it (gone at final). Reduced motion: the pre-mount boot rules below
     still show the final state. */
  [data-coming-hero][data-sequence-boot='js'] [data-hero-name],
  [data-coming-hero][data-sequence-boot='js'] [data-hero-eyebrow],
  [data-coming-hero][data-sequence-boot='js'] [data-hero-tagline],
  [data-coming-hero][data-sequence-boot='js'] [data-hero-credit] {
    opacity: 0;
  }
  [data-coming-hero][data-sequence-boot='js'][data-sequence-phase='revealUp'] [data-hero-name],
  [data-coming-hero][data-sequence-boot='js'][data-sequence-phase='revealUp'] [data-hero-eyebrow],
  [data-coming-hero][data-sequence-boot='js'][data-sequence-phase='full'] [data-hero-name],
  [data-coming-hero][data-sequence-boot='js'][data-sequence-phase='full'] [data-hero-eyebrow],
  [data-coming-hero][data-sequence-boot='js'][data-sequence-phase='revealDown'] [data-hero-name],
  [data-coming-hero][data-sequence-boot='js'][data-sequence-phase='revealDown'] [data-hero-eyebrow],
  [data-coming-hero][data-sequence-boot='js'][data-sequence-phase='fate'] [data-hero-name],
  [data-coming-hero][data-sequence-boot='js'][data-sequence-phase='fate'] [data-hero-eyebrow],
  [data-coming-hero][data-sequence-boot='js'][data-sequence-phase='fate'] [data-hero-tagline],
  [data-coming-hero][data-sequence-boot='js'][data-sequence-phase='fate'] [data-hero-credit],
  [data-coming-hero][data-sequence-boot='js'][data-sequence-phase='scramble'] [data-hero-name],
  [data-coming-hero][data-sequence-boot='js'][data-sequence-phase='scramble'] [data-hero-eyebrow],
  [data-coming-hero][data-sequence-boot='js'][data-sequence-phase='scramble'] [data-hero-tagline],
  [data-coming-hero][data-sequence-boot='js'][data-sequence-phase='scramble'] [data-hero-credit],
  [data-coming-hero][data-sequence-boot='js'][data-sequence-phase='final'] [data-hero-name],
  [data-coming-hero][data-sequence-boot='js'][data-sequence-phase='final'] [data-hero-eyebrow],
  [data-coming-hero][data-sequence-boot='js'][data-sequence-phase='final'] [data-hero-tagline] {
    opacity: 1;
  }
  /* WU31 — the fate line is a QUOTE, not the headline: 15 px against the
     watcher line's 18 px (text-lg), with the credit smaller still (text-xs,
     12 px). It grows into the watcher size as the corruption resolves. */
  [data-coming-hero][data-sequence-boot='js'][data-sequence-phase='fate'] [data-hero-tagline],
  [data-coming-hero][data-sequence-boot='js'][data-sequence-phase='scramble'] [data-hero-tagline] {
    font-size: 0.9375rem;
    transition: font-size 400ms ease;
  }
  [data-coming-hero] [data-hero-eyebrow],
  [data-coming-hero] [data-hero-tagline],
  [data-coming-hero] [data-hero-credit] {
    transition: opacity 900ms ease;
  }
  [data-coming-hero] [data-hero-terminal] {
    transition: opacity 900ms ease;
  }
  .hero-terminal-departed {
    opacity: 0 !important;
    pointer-events: none;
  }
  .hero-credit {
    opacity: 0;
  }
  .hero-credit-on {
    opacity: 1;
  }
  /* Reduced motion: even the PRE-MOUNT boot frame is truthful — the final
     state shows (scene layer visible, terminal hidden). */
  @media (prefers-reduced-motion: reduce) {
    [data-coming-hero][data-sequence-boot='js']:not([data-ready]) .scene-layer {
      opacity: 1;
    }
    [data-coming-hero][data-sequence-boot='js']:not([data-ready]) [data-hero-eyebrow] {
      opacity: 1;
    }
    [data-coming-hero][data-sequence-boot='js']:not([data-ready]) [data-hero-tagline] {
      opacity: 1;
    }
    [data-coming-hero][data-sequence-boot='js']:not([data-ready]) [data-hero-name] {
      opacity: 1;
    }
    [data-coming-hero][data-sequence-boot='js']:not([data-ready]) [data-hero-terminal] {
      opacity: 0;
    }
    [data-coming-hero] [data-hero-terminal] {
      transition: none;
    }
    [data-coming-hero] [data-hero-eyebrow],
    [data-coming-hero] [data-hero-tagline],
    [data-coming-hero] [data-hero-credit] {
      transition: none;
    }
    .caret {
      animation: none;
    }
  }

  /* The text sits over the scene; the scrim guarantees its contrast regardless
     of what the aurora or the wash do underneath. Measured worst case (thinnest
     point behind the text block over a bone-50 scene pixel): 12.2:1; the amber
     eyebrow reads 7.4:1 — both above the 4.5:1 design-system rule. */
  .scrim {
    background: linear-gradient(
      105deg,
      rgb(11 11 12 / 0.92) 0%,
      rgb(11 11 12 / 0.85) 34%,
      rgb(11 11 12 / 0.4) 62%,
      rgb(11 11 12 / 0.55) 100%
    );
  }

  /* ---- Act 1: the terminal (VT323, the page palette, no green) ---------- */
  .terminal {
    font-family: 'VT323', ui-monospace, monospace;
    font-size: clamp(20px, 2.6vw, 28px);
    line-height: 1.3;
  }
  .caret {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 0.1em;
    vertical-align: -0.15em;
    background: var(--color-bone-50);
    animation: hero-caret-blink 900ms steps(1) infinite;
  }
  @keyframes hero-caret-blink {
    50% {
      opacity: 0;
    }
  }
</style>
