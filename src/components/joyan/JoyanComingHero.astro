---
/**
 * WU33 — the public sequence hero. THE CONTENT GATE IS REMOVED (the user's
 * decision, reversing WU29/WU31's black start): everything — the Joyan name,
 * the eyebrow, the scene and the final watcher line — is VISIBLE FROM FIRST
 * PAINT, with zero JavaScript, with reduced motion, and at first paint with
 * scripting on. The sequence only ever ADDS motion on top, never a door that
 * hides content: the terminal beat types OVER the already-visible page
 * (VT323, bone text, amber prompt, no green), the reveal is the ENGINE's own
 * HALFTONE MASK (the WU31/WU32 warp burst is retired from the public page) —
 * a threshold in our dot language assembling the scene from the ramp upward,
 * radial from the subject, over the SAME payload, grid, joyan-page palette
 * and stars/aurora/wash/vignette overlays, driven by `~/lib/public-sequence`
 * (the ONE runtime path on the public pages), settling byte-identical to the
 * composition this page always showed. The fate line then decodes IN to the
 * tagline slot with its TERMINATOR 2 · SARAH CONNOR credit, holds ~5 s (the
 * WU32 pacing defect), corrupts through our dot-ramp glyphs (· • ● — never
 * unicode noise) and re-forms into the watcher line, which stays.
 *
 * The ES/EN switch is a real link pair in the top corner (each page links to
 * the other locale; no JS, and the invisible skip ignores it). No other
 * controls: the hero autoplays (WU20). The eyebrow is the shipped choice
 * "TRANSMISIÓN"/"TRANSMISSION" (alternatives recorded in
 * odd/tasks/dither-iteration.md and docs/DESIGN.md).
 */
interface Props {
  /** Build-time baked poster PNG of the scene's poster frame (data URI or asset path). */
  poster: string;
  /** The pipeline's own serialisation of the converted scene, as JSON text. */
  payload: string;
  /** The image-palette id and overlay ids the treatment applies. */
  palette?: string;
  overlays?: string;
  name: string;
  /** The shipped eyebrow (WU29: "TRANSMISIÓN" / "TRANSMISSION"). */
  eyebrow: string;
  /** The fate line — the first tagline-slot phrase after the reveal. */
  fateLine: string;
  /** The watcher line — the final phrase, also the no-JS/reduced content. */
  watcherLine: string;
  credit: string;
  /** The other locale's path and label for the corner link pair. */
  localeHref: string;
  localeLabel: string;
  footerNote: string;
  contactEmail: string;
  discordUrl?: string;
  discordLabel: string;
}
const {
  poster, payload, palette = 'joyan-page', overlays = 'stars,aurora,wash', name, eyebrow, fateLine, watcherLine,
  credit, localeHref, localeLabel, footerNote, contactEmail, discordUrl = '', discordLabel,
} = Astro.props;

/**
 * DISCORD_INVITE_URL (WU22) — the future Discord invite lives HERE, in one
 * clearly named constant. The user will configure it later; until then the
 * mark renders without a link (no invented URL is ever shipped).
 */
const DISCORD_INVITE_URL = '';
const discordHref = discordUrl || DISCORD_INVITE_URL;

/**
 * WU33 — the Discord mark is the 88-CELL rendering the user picked (the
 * pipeline's own conversion, baked through the engine's raster path and
 * committed under `public/assets/brand/`). The old 16 × 10 hand grid is gone
 * from the footer; the attribute contract (`data-discord-mark`) stays.
 */
const DISCORD_MARK_SRC = '/assets/brand/discord-mark-88.png';
const DISCORD_MARK_PX = 88;
---

<section
  data-coming-hero
  data-hero-autoplay
  data-hero-palette={palette}
  data-hero-overlays={overlays}
  class="relative flex min-h-[88dvh] w-full flex-col overflow-hidden bg-ink-950"
  aria-labelledby="coming-hero-name"
>
  {/* WU33 — NO boot marker, NO content gate: the server markup is the live
      state (poster, eyebrow, name, watcher line) and the sequence only ever
      adds motion on top. The scene layer is visible from first paint; the
      canvas takes over at the reveal (data-playing) and the poster
      crossfades out while the halftone mask resolves the scene. */}
  <div class="scene-layer absolute inset-0" aria-hidden="true">
    <img
      src={poster}
      alt=""
      data-hero-poster
      width="1280"
      height="640"
      loading="eager"
      decoding="async"
      class="block h-full w-full object-cover"
    />
    <canvas class="block h-full w-full object-cover"></canvas>
  </div>
  {/* Measured scrim: the text region stays dark no matter what the scene does. */}
  <div class="scrim absolute inset-0" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto flex w-full max-w-6xl flex-1 flex-col px-4 sm:px-6">
    <div class="mt-[14dvh] max-w-xl">
      <p data-hero-eyebrow class="font-mono text-xs uppercase tracking-[0.3em] text-accent">{eyebrow}</p>
      {/* WU33 — the name is FIRST-PAINT CONTENT: it is never decoded, never
          hidden, never phase-gated. The sequence only ever adds motion around
          it; aria-label keeps the accessible name stable regardless. */}
      <h1 id="coming-hero-name" data-hero-name class="font-display mt-4 text-5xl tracking-tight text-bone-50 sm:text-7xl" aria-label={name}>{name}</h1>
      {/* The tagline slot: the SERVER content is the final watcher line (what
          no-JS, reduced motion and first paint all show). The arc decodes IN
          PLACE on top of it: after the reveal the fate line decodes in,
          holds ~5 s (WU33 pacing), corrupts through our dot-ramp glyphs and
          re-forms into the watcher line, which stays. */}
      <div data-hero-terminal class="terminal mt-6" aria-hidden="true">
        <p class="text-bone-50">
          <span class="text-accent">&gt;</span>
          <span data-hero-typed data-hero-terminal-text="Wake up, Neo…"> </span><span class="caret"></span>
        </p>
      </div>
      <p
        data-hero-tagline
        data-hero-fate={fateLine}
        data-hero-watcher={watcherLine}
        class="mt-6 max-w-md text-lg leading-relaxed text-bone-100"
      >{watcherLine}</p>
      {/* WU32 — the credit sits clearly BELOW the eyebrow in hierarchy:
          10 px plomo with reduced tracking, against the eyebrow's 12 px amber
          0.3em (the user rejected the 12 px amber credit competing with the
          eyebrow). It rides with the fate line and leaves with it. */}
      <p data-hero-credit class="hero-credit mt-4 font-mono text-[10px] uppercase tracking-[0.12em] text-plomo-400">{credit}</p>
    </div>
    <p data-hero-status class="sr-only" role="status">
      Static poster
    </p>
  </div>
  {/* WU29 — the ES/EN switch is a real link pair: each page links to the
      other locale. No JS, no other control (the hero autoplays, WU20). */}
  <nav data-hero-locale aria-label="Language / Idioma" class="absolute top-4 right-4 z-20 sm:top-6 sm:right-6">
    <a
      href={localeHref}
      hreflang={localeLabel === 'EN' ? 'en' : 'es'}
      lang={localeLabel === 'EN' ? 'en' : 'es'}
      class="font-mono text-xs uppercase tracking-[0.3em] text-bone-100 underline decoration-hairline underline-offset-4 transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-accent"
    >{localeLabel}</a>
  </nav>
  <script is:inline type="application/json" data-coming-hero-scene set:html={payload} />
</section>

<footer class="relative z-10 border-t border-hairline bg-ink-950">
  <div
    class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 py-8 sm:flex-row sm:items-center sm:justify-between sm:px-6"
  >
    <div class="flex items-center gap-4">
      {/* WU32 — the dot rule is GONE (the user rejected it): the footer note
          stands on its own; the contact row is unchanged. */}
      <p class="text-xs text-plomo-400">{footerNote}</p>
    </div>
    <div class="flex items-center gap-6">
      <a
        href={`mailto:${contactEmail}`}
        class="font-mono text-sm text-bone-100 underline decoration-hairline underline-offset-4 transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-accent"
      >
        {contactEmail}
      </a>
      {discordHref ? (
        <a
          href={discordHref}
          rel="noopener"
          aria-label={discordLabel}
          title={discordLabel}
          class="text-bone-100 transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-accent"
        >
          <img
            src={DISCORD_MARK_SRC}
            alt=""
            width={DISCORD_MARK_PX * 2}
            height={DISCORD_MARK_PX * 2}
            loading="lazy"
            decoding="async"
            class="block h-[88px] w-[88px]"
          />
        </a>
      ) : (
        <span
          aria-label={discordLabel}
          title={discordLabel}
          class="text-plomo-400"
          data-discord-mark
        >
          <img
            src={DISCORD_MARK_SRC}
            alt=""
            width={DISCORD_MARK_PX * 2}
            height={DISCORD_MARK_PX * 2}
            loading="lazy"
            decoding="async"
            class="block h-[88px] w-[88px]"
          />
        </span>
      )}
    </div>
  </div>
</footer>

<script>
  // The ONE runtime import on the public page: the public sequence runtime,
  // driving the black start, the engine reveal and the corrupted text arc.
  import '~/lib/public-sequence';
</script>

<style>
  /* ---- WU33 states ---------------------------------------------------------
     The content gate is REMOVED: nothing here ever hides the name, the
     eyebrow or the tagline — they are first-paint content in every state
     (no-JS, reduced motion, scripting). The scene layer is visible from
     first paint; the ONLY dimming is the poster's crossfade, gated on
     [data-playing], which the runtime sets when the halftone reveal starts
     (never before, never without scripting). The terminal is the one
     pre-reveal-hidden element: the beat fades in when its typing phase runs. */
  .scene-layer {
    display: grid;
  }
  /* WU33 — the poster and the canvas share ONE grid cell: the crossfade keeps
     the poster in the layout (opacity, not display), so without this the
     canvas would drop to a second grid row and paint in the lower half. */
  .scene-layer > img,
  .scene-layer > canvas {
    grid-area: 1 / 1;
  }
  /* The baked poster is the no-JS still and the first-paint scene; the canvas
     takes over at the reveal and the poster crossfades out beneath it. */
  [data-coming-hero] [data-hero-poster] {
    opacity: 1;
    transition: opacity 600ms ease;
  }
  [data-coming-hero] canvas {
    display: none;
  }
  [data-coming-hero][data-playing] canvas {
    display: block;
  }
  [data-coming-hero][data-playing] [data-hero-poster] {
    opacity: 0;
  }

  /* The terminal beat: hidden until its typing phase (a phase attribute only
     scripting can set), gone once the reveal takes over. */
  [data-coming-hero] [data-hero-terminal] {
    opacity: 0;
    transition: opacity 900ms ease;
  }
  [data-coming-hero][data-sequence-phase='typing'] [data-hero-terminal] {
    opacity: 1;
  }
  .hero-terminal-departed {
    opacity: 0 !important;
    pointer-events: none;
  }

  /* The credit rides with the fate line and leaves with it. */
  .hero-credit {
    opacity: 0;
  }
  .hero-credit-on {
    opacity: 1;
  }
  [data-coming-hero] [data-hero-credit] {
    transition: opacity 900ms ease;
  }

  /* WU32/WU33 — the fate line is a QUOTE, not the headline: 15 px against the
     watcher line's 18 px (text-lg), with the credit smaller still (10 px). It
     grows into the watcher size as the corruption resolves. The box is pinned
     by the runtime during every decode, so the size change never shifts
     layout. */
  [data-coming-hero][data-sequence-phase='fateIn'] [data-hero-tagline],
  [data-coming-hero][data-sequence-phase='fate'] [data-hero-tagline],
  [data-coming-hero][data-sequence-phase='scramble'] [data-hero-tagline] {
    font-size: 0.9375rem;
    transition: font-size 400ms ease;
  }

  /* Reduced motion: the sequence never runs (the runtime skips to the final
     state), so there is nothing to un-hide — the server markup IS the final
     state. Only the motion ornaments stop. */
  @media (prefers-reduced-motion: reduce) {
    [data-coming-hero] [data-hero-poster] {
      transition: none;
    }
    [data-coming-hero] [data-hero-terminal] {
      transition: none;
    }
    [data-coming-hero] [data-hero-credit] {
      transition: none;
    }
    .caret {
      animation: none;
    }
  }

  /* The text sits over the scene; the scrim guarantees its contrast regardless
     of what the aurora or the wash do underneath. Measured worst case (thinnest
     point behind the text block over a bone-50 scene pixel): 12.2:1; the amber
     eyebrow reads 7.4:1 — both above the 4.5:1 design-system rule. */
  .scrim {
    background: linear-gradient(
      105deg,
      rgb(11 11 12 / 0.92) 0%,
      rgb(11 11 12 / 0.85) 34%,
      rgb(11 11 12 / 0.4) 62%,
      rgb(11 11 12 / 0.55) 100%
    );
  }

  /* ---- Act 1: the terminal (VT323, the page palette, no green) ---------- */
  .terminal {
    font-family: 'VT323', ui-monospace, monospace;
    font-size: clamp(20px, 2.6vw, 28px);
    line-height: 1.3;
  }
  .caret {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 0.1em;
    vertical-align: -0.15em;
    background: var(--color-bone-50);
    animation: hero-caret-blink 900ms steps(1) infinite;
  }
  @keyframes hero-caret-blink {
    50% {
      opacity: 0;
    }
  }
</style>
