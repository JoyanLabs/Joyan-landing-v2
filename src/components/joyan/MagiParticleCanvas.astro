---
import AgentNetworkDiagram from '~/components/joyan/AgentNetworkDiagram.astro';
import { MAGI_NETWORK } from '~/lib/magi-network';
import type { MotionContent } from '~/lib/i18n/types';
import { cn } from '~/lib/utils';

export interface Props {
  /** Localized MAGI motion labels (docs/DESIGN.md — Motion guide). */
  motion: MotionContent;
  class?: string;
}

const { motion, class: className } = Astro.props;
---

<!--
  Optional MAGI particle overlay (docs/DESIGN.md — Motion guide): the static
  480x300 SVG diagram is the no-JS and reduced-motion renderer; the canvas
  adds amber particles traveling the edges while the section is visible.
  Decorative: the canvas is aria-hidden; the localized label and status
  elements carry the accessible meaning.
-->
<div class={cn('relative', className)}>
  <AgentNetworkDiagram />
  <canvas
    aria-hidden="true"
    data-magi-particles
    data-node-count={MAGI_NETWORK.nodes.length}
    data-edge-count={MAGI_NETWORK.edges.length}
    data-particle-count={MAGI_NETWORK.particles.length}
    data-max-dpr="2"
    data-fps="30"
    data-active-status={motion.activeStatus}
    class="pointer-events-none absolute inset-0 block h-full w-full"></canvas>
  <p class="sr-only" data-magi-label>{motion.canvasLabel}</p>
  <p class="mt-3 font-mono text-xs uppercase tracking-widest text-plomo-400" data-magi-status>
    {motion.staticStatus}
  </p>
</div>

<script>
  import { MAGI_NETWORK } from '~/lib/magi-network';

  // Motion contract (docs/DESIGN.md — Motion guide): one 30fps loop capped at
  // devicePixelRatio 2, paused offscreen or hidden and on pagehide, resumed on
  // re-entry or pageshow, cleaned up on Astro view transitions. Reduced motion
  // and missing Canvas support keep the static SVG renderer — the overlay is
  // progressive enhancement.

  const REDUCED_MOTION_QUERY = '(prefers-reduced-motion: reduce)';

  let stopCurrent: (() => void) | null = null;

  function stop(): void {
    if (stopCurrent) {
      stopCurrent();
      stopCurrent = null;
    }
  }

  function start(): void {
    stop();
    const canvas = document.querySelector<HTMLCanvasElement>('canvas[data-magi-particles]');
    if (!canvas || window.matchMedia(REDUCED_MOTION_QUERY).matches) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    stopCurrent = run(canvas, ctx);
  }

  function run(canvas: HTMLCanvasElement, ctx: CanvasRenderingContext2D): () => void {
    const maxDpr = Number(canvas.getAttribute('data-max-dpr')) || 2;
    const fps = Number(canvas.getAttribute('data-fps')) || 30;
    const frameMs = 1000 / fps;
    const activeStatus = canvas.getAttribute('data-active-status');
    const status = document.querySelector('[data-magi-status]');
    const progress = MAGI_NETWORK.particles.map((particle) => particle.progress);
    let rafId = 0;
    let lastTime = 0;
    let running = false;

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, maxDpr);
      canvas.width = Math.max(1, Math.round(canvas.clientWidth * dpr));
      canvas.height = Math.max(1, Math.round(canvas.clientHeight * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const draw = (dt: number) => {
      ctx.clearRect(0, 0, canvas.clientWidth, canvas.clientHeight);
      ctx.save();
      ctx.scale(canvas.clientWidth / MAGI_NETWORK.width, canvas.clientHeight / MAGI_NETWORK.height);
      for (let i = 0; i < MAGI_NETWORK.particles.length; i += 1) {
        const particle = MAGI_NETWORK.particles[i];
        progress[i] = (progress[i] + particle.speed * dt) % 1;
        const edge = MAGI_NETWORK.edges[particle.edge];
        const from = MAGI_NETWORK.nodes[edge.from];
        const to = MAGI_NETWORK.nodes[edge.to];
        const x = from.x + (to.x - from.x) * progress[i];
        const y = from.y + (to.y - from.y) * progress[i];
        const dx = (to.x - from.x) * particle.speed * 0.45;
        const dy = (to.y - from.y) * particle.speed * 0.45;
        // trailing segment fades behind the amber particle head
        ctx.strokeStyle = '#FFB000';
        ctx.lineWidth = 1.5;
        ctx.globalAlpha = 0.35;
        ctx.beginPath();
        ctx.moveTo(x - dx, y - dy);
        ctx.lineTo(x, y);
        ctx.stroke();
        ctx.fillStyle = '#FFB000';
        ctx.globalAlpha = 0.9;
        ctx.beginPath();
        ctx.arc(x, y, 2.4, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();
      ctx.globalAlpha = 1;
    };

    const tick = (now: number) => {
      if (!running) return;
      if (lastTime === 0) lastTime = now;
      const elapsed = now - lastTime;
      if (elapsed >= frameMs) {
        lastTime = now;
        draw(Math.min(elapsed / 1000, 0.1));
      }
      rafId = requestAnimationFrame(tick);
    };

    const startLoop = () => {
      if (running) return;
      running = true;
      lastTime = 0;
      rafId = requestAnimationFrame(tick);
      if (status && activeStatus) status.textContent = activeStatus;
    };

    const stopLoop = () => {
      running = false;
      cancelAnimationFrame(rafId);
    };

    const onVisibilityChange = () => {
      if (document.hidden) stopLoop();
      else startLoop();
    };
    const onPageHide = () => stopLoop();
    const onPageShow = () => {
      if (!document.hidden) startLoop();
    };
    const onResize = () => resize();

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) startLoop();
          else stopLoop();
        }
      },
      { threshold: 0 }
    );

    resize();
    observer.observe(canvas);
    window.addEventListener('visibilitychange', onVisibilityChange);
    window.addEventListener('pagehide', onPageHide);
    window.addEventListener('pageshow', onPageShow);
    window.addEventListener('resize', onResize);

    return () => {
      stopLoop();
      observer.disconnect();
      window.removeEventListener('visibilitychange', onVisibilityChange);
      window.removeEventListener('pagehide', onPageHide);
      window.removeEventListener('pageshow', onPageShow);
      window.removeEventListener('resize', onResize);
    };
  }

  // Astro view-transition lifecycle: boot on every page load and stop before
  // the DOM swap so the loop never survives into the next page.
  document.addEventListener('astro:page-load', start);
  document.addEventListener('astro:before-swap', stop);
  start();
</script>
