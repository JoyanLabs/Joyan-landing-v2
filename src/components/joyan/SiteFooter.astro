---
import Wordmark from '~/components/joyan/Wordmark.astro';
import { JOURNAL_ROUTES, LOCALES } from '~/lib/i18n';
import type { FooterContent, Locale, NavContent } from '~/lib/i18n/types';

export interface Props {
  content: FooterContent;
  nav: NavContent;
  locale: Locale;
  /** Current page pathname — on detail pages anchors use the landing base. */
  path?: string;
}

const { content, nav, locale, path } = Astro.props;
// Same rule as SiteHeader: detail pages have no landing sections, so footer
// links point at the locale landing base (/#agents, /en#agents).
const isDetail =
  typeof path === 'string' && path !== JOURNAL_ROUTES[locale] && path.startsWith(`${JOURNAL_ROUTES[locale]}/`);
const anchorBase = isDetail ? (locale === LOCALES.ES ? '/' : '/en') : '';
---

<!-- Non-navigable: page footer carries no anchor id (design: no id). --><!-- bg-ink-950: opaque shell so the L1 texture never shows behind footer text. -->
<footer class="border-t border-hairline bg-ink-950">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div>
        <a href="#top" class="transition-opacity hover:opacity-80" aria-label="Joyan">
          <Wordmark />
        </a>
        <p class="mt-5 max-w-sm leading-relaxed text-plomo-400">{content.tagline}</p>
      </div>
      <nav aria-label="Footer" class="flex flex-col gap-3">
        {
          nav.links.map((link) => (
            <a
              href={`${anchorBase}#${link.anchor}`}
              class="font-mono text-xs uppercase tracking-widest text-plomo-400 transition-colors hover:text-bone-50"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
    <p class="mt-12 border-t border-hairline pt-6 font-mono text-xs tracking-widest text-plomo-400">
      {content.legal}
    </p>
  </div>
</footer>
