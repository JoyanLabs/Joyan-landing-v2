---
import SectionHeader from '~/components/joyan/SectionHeader.astro';
import JournalEntryRow from '~/components/joyan/JournalEntryRow.astro';
import { LOCALES, type Locale } from '~/lib/i18n';
import type { JournalContent } from '~/lib/i18n/types';
import { getLatestJournal } from '~/utils/journal';

export interface Props {
  locale: Locale;
  content: JournalContent;
}

const { locale, content } = Astro.props;
const entries = await getLatestJournal(locale, 3);
// Relative archive link: `bitacora` from `/` resolves to /bitacora and `log`
// from /en resolves to /en/log. The iteration-2 route contract rejects any
// absolute `/en/…` link target on the EN landing, so the landing link stays
// relative (the archives themselves use absolute self-canonical URLs).
const archiveHref = locale === LOCALES.ES ? 'bitacora' : 'log';
---

<section id="bitacora" class="scroll-mt-24" data-reveal>
  <div class="mx-auto max-w-6xl px-6 py-24">
    <SectionHeader index={content.index} kicker={content.kicker} title={content.title} />
    <p class="mt-8 max-w-2xl text-lg leading-relaxed text-bone-100">{content.lead}</p>
    {
      entries.length > 0 ? (
        <ul class="mt-14">
          {entries.map((entry) => (
            <JournalEntryRow entry={entry} content={content} locale={locale} />
          ))}
        </ul>
      ) : (
        <p class="mt-14 border-t border-hairline pt-8 font-mono text-xs uppercase tracking-widest text-plomo-400">
          {content.emptyState}
        </p>
      )
    }
    <a
      href={archiveHref}
      class="mt-10 inline-block font-mono text-xs uppercase tracking-widest text-bone-50 transition-colors hover:text-accent"
    >
      {content.archiveLabel}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
