---
import Wordmark from '~/components/joyan/Wordmark.astro';
import DitherFigure from '~/components/joyan/DitherFigure.astro';
import type { HeroContent } from '~/lib/i18n/types';

export interface Props {
  content: HeroContent;
}

const { content } = Astro.props;
---

<section id="top" class="flex min-h-[100dvh] items-center">
  <div class="mx-auto grid w-full max-w-6xl gap-14 px-6 py-24 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
    <div>
      <Wordmark class="mb-10" />
      <p class="font-mono text-xs uppercase tracking-widest text-plomo-400">
        {content.kicker}
        <span class="caret ml-2 inline-block h-[1.05em] w-[0.5em] bg-accent align-middle" aria-hidden="true"></span>
      </p>
      <h1 class="text-display mt-6 text-4xl text-bone-50 md:text-6xl">{content.title}</h1>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-bone-100">{content.lead}</p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="#magi"
          class="bg-accent px-6 py-3 font-mono text-xs uppercase tracking-widest text-accent-ink transition-opacity hover:opacity-90"
        >
          {content.ctaPrimary}
        </a>
        <a
          href="#ecosystem"
          class="border border-hairline px-6 py-3 font-mono text-xs uppercase tracking-widest text-bone-100 transition-colors hover:border-plomo-400"
        >
          {content.ctaSecondary}
        </a>
      </div>
    </div>
    <DitherFigure src="/assets/dither/hero-dither.png" alt="" width={1600} height={900} />
  </div>
</section>

<style>
  @keyframes joyan-caret {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  .caret {
    animation: joyan-caret 1.1s step-end infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }
</style>
