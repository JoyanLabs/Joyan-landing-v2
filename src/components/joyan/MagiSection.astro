---
import SectionHeader from '~/components/joyan/SectionHeader.astro';
import TerminalBlock from '~/components/joyan/TerminalBlock.astro';
import MagiParticleCanvas from '~/components/joyan/MagiParticleCanvas.astro';
import JournalDisclosureList from '~/components/joyan/JournalDisclosureList.astro';
import SectionFilm from '~/components/joyan/SectionFilm.astro';
import type { MagiContent } from '~/lib/i18n/types';

export interface Props {
  content: MagiContent;
}

const { content } = Astro.props;
---

<section id="magi" class="scroll-mt-24" data-reveal>
  <div class="mx-auto max-w-6xl px-6 py-24">
    <SectionHeader index={content.index} kicker={content.kicker} title={content.title} />
    <p class="mt-8 max-w-2xl text-lg leading-relaxed text-bone-100">{content.lead}</p>
    <div class="mt-14 grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-16">
      <div>
        <JournalDisclosureList idPrefix="magi-disclosure" items={content.items} titleLevel={3} />
      </div>
      <div class="flex flex-col gap-8">
        <MagiParticleCanvas motion={content.motion} class="lg:mt-4" />
        <TerminalBlock lines={content.terminalLines} />
      </div>
      <SectionFilm
        stem="harness-assembly"
        copy={content.film}
        alt={content.figure.alt}
        class="mt-10"
      />
    </div>
  </div>
</section>
