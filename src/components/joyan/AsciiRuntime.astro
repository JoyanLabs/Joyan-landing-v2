---
const PIECES = { DONUT: 'donut', CUP: 'java' } as const;
interface Props {
  piece: (typeof PIECES)[keyof typeof PIECES];
  title: string;
  description: string;
}
const { piece, title, description } = Astro.props;
const text = piece === PIECES.DONUT;
---

<section data-ascii-piece={piece} class="runtime border-t border-hairline py-8">
  <div class="mb-4 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h2 class="text-xl text-bone-50">{title}</h2>
      <p class="mt-2 max-w-prose text-sm text-plomo-400">{description}</p>
    </div>
    <button
      type="button"
      disabled
      aria-controls={`ascii-${piece}`}
      aria-pressed="false"
      class="border border-hairline px-4 py-2 font-mono text-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent disabled:opacity-60"
    >Play {piece}</button>
  </div>
  <div class="runtime-frame bg-ink-900" aria-hidden="true">
    {
      text ? <pre id={`ascii-${piece}`} data-ascii-output class="font-mono text-bone-100"></pre>
        : <canvas id={`ascii-${piece}`} data-ascii-output width="420" height="560"></canvas>
    }
    <p data-ascii-fallback class="p-6 text-sm text-plomo-400">
      {text ? 'Static fallback: a shaded torus turning on two axes. Live ASCII text requires JavaScript.'
        : 'Static fallback: a steaming cup with red and blue glyphs. The colored canvas requires JavaScript.'}
    </p>
  </div>
  <p data-ascii-status class="mt-3 font-mono text-xs text-plomo-400" role="status">
    Static fallback · JavaScript unavailable
  </p>
</section>

<script>
  import '~/lib/ascii-runtime';
</script>

<style>
  .runtime-frame {
    display: grid;
    place-items: center;
    min-width: 0;
  }
  pre {
    margin: 0;
    padding: 0;
    font-size: clamp(12px, 2.1vw, 16px);
    line-height: 1.2;
    font-variant-ligatures: none;
    letter-spacing: 0;
    white-space: pre;
  }
  canvas {
    display: none;
    width: 100%;
    max-width: 420px;
    aspect-ratio: 3 / 4;
  }
  [data-ready] canvas {
    display: block;
  }
  [data-ready] [data-ascii-fallback] {
    display: none;
  }
</style>
