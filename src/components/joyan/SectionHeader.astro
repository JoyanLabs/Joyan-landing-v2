---
export interface Props {
  /** Mono section index label, e.g. "01". */
  index: string;
  /** Optional kicker shown after the index on the mono line. */
  kicker?: string;
  /** Display title (text-display, uppercase). */
  title: string;
  /**
   * Heading level: sections on a landing render h2 under the hero h1;
   * standalone pages (journal archives) render their only title as h1.
   */
  headingLevel?: 1 | 2;
}

const { index, kicker, title, headingLevel = 2 } = Astro.props;
const HeadingTag = headingLevel === 1 ? 'h1' : 'h2';
---

<header class="border-t border-hairline pt-6">
  <p class="font-mono text-xs uppercase tracking-widest text-plomo-400">
    {index}
    {kicker && <> — {kicker}</>}
  </p>
  <HeadingTag class="text-display mt-4 text-3xl text-bone-50 md:text-5xl">{title}</HeadingTag>
</header>
