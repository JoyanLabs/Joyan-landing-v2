---
import SectionHeader from '~/components/joyan/SectionHeader.astro';
import SectionFilm from '~/components/joyan/SectionFilm.astro';
import JournalDisclosureList from '~/components/joyan/JournalDisclosureList.astro';
import type { IllustratedSectionContent } from '~/lib/i18n/types';

export interface Props {
  content: IllustratedSectionContent;
}

const { content } = Astro.props;
---

<section id="agents" class="scroll-mt-24" data-reveal>
  <div class="mx-auto max-w-6xl px-6 py-24">
    <div class="grid gap-14 lg:grid-cols-[1fr_0.85fr] lg:gap-16">
      <div>
        <SectionHeader index={content.index} kicker={content.kicker} title={content.title} />
        <p class="mt-8 max-w-2xl text-lg leading-relaxed text-bone-100">{content.lead}</p>
        <div class="mt-14">
          <JournalDisclosureList idPrefix="agents-disclosure" items={content.items} titleLevel={3} />
        </div>
      </div>
      <SectionFilm
        stem="action-gates"
        copy={content.film}
        alt={content.figure.alt}
        class="self-start"
      />
    </div>
  </div>
</section>
