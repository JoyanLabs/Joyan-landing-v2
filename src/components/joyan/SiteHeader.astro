---
import Wordmark from '~/components/joyan/Wordmark.astro';
import LanguageToggle from '~/components/joyan/LanguageToggle.astro';
import { JOURNAL_ROUTES, LOCALES } from '~/lib/i18n';
import type { Locale, NavContent } from '~/lib/i18n/types';

export interface Props {
  locale: Locale;
  nav: NavContent;
  /** Current page pathname — forwarded to the language toggle. */
  path?: string;
}

const { locale, nav, path } = Astro.props;
// On detail pages the landing section anchors do not exist, so nav links
// point at the locale landing base (/#agents, /en#agents) instead of bare
// in-page anchors. Landings and archives keep the plain anchor.
const isDetail =
  typeof path === 'string' && path !== JOURNAL_ROUTES[locale] && path.startsWith(`${JOURNAL_ROUTES[locale]}/`);
const anchorBase = isDetail ? (locale === LOCALES.ES ? '/' : '/en') : '';
---

<header class="sticky top-0 z-40 border-b border-hairline bg-ink-950/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-4">
    <a href="#top" class="transition-opacity hover:opacity-80" aria-label="Joyan">
      <Wordmark />
    </a>
    <div class="flex items-center gap-8">
      <nav aria-label="Main" class="hidden gap-8 sm:flex">
        {
          nav.links.map((link) => (
            <a
              href={`${anchorBase}#${link.anchor}`}
              class="font-mono text-xs uppercase tracking-widest text-plomo-400 transition-colors hover:text-bone-50"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <LanguageToggle locale={locale} label={nav.toggle} path={path} />
    </div>
  </div>
</header>
