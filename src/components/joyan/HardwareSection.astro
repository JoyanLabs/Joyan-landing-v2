---
import SectionHeader from '~/components/joyan/SectionHeader.astro';
import SectionFilm from '~/components/joyan/SectionFilm.astro';
import JournalDisclosureList from '~/components/joyan/JournalDisclosureList.astro';
import type { HardwareContent } from '~/lib/i18n/types';

export interface Props {
  content: HardwareContent;
}

const { content } = Astro.props;
---

<section id="hardware" class="scroll-mt-24" data-reveal>
  <div class="mx-auto max-w-6xl px-6 py-24">
    <div class="grid gap-14 lg:grid-cols-[1fr_0.85fr] lg:gap-16">
      <div>
        <SectionHeader index={content.index} kicker={content.kicker} title={content.title} />
        <p class="mt-8 max-w-2xl text-lg leading-relaxed text-bone-100">{content.lead}</p>
        <div class="mt-14">
          <JournalDisclosureList idPrefix="hardware-disclosure" items={content.items} titleLevel={3} />
        </div>
      </div>
      <!--
        CSS-only hardware surface (docs/DESIGN.md — Motion guide): the figure
        tilts, a scan line sweeps, and a corner trace highlights on hover or
        keyboard focus only — never idle — and all treatments are static under
        reduced motion. The wrapper is the keyboard-visible focus target.
      -->
      <SectionFilm
        stem="signal-freshness"
        copy={content.film}
        alt={content.figure.alt}
        class="hardware-surface self-start"
        surface
      />
    </div>

    <div class="mt-14 border-t border-hairline pt-10">
      <p class="font-mono text-xs uppercase tracking-widest text-accent">{content.prototypeInvitation.status}</p>
      <p class="mt-4 max-w-2xl leading-relaxed text-plomo-400">{content.prototypeInvitation.body}</p>
    </div>
  </div>
</section>
