---
import { cn } from '~/lib/utils';

export interface Props {
  /** Path to a pre-baked dither asset (ADR-1: no canvas). */
  src: string;
  alt: string;
  caption?: string;
  /** Intrinsic dimensions reserve layout space and avoid CLS. */
  width: number;
  height: number;
  class?: string;
}

const { src, alt, caption, width, height, class: className } = Astro.props;
---

<figure class={cn('border border-hairline bg-ink-900', className)}>
  <img src={src} alt={alt} width={width} height={height} class="block h-auto w-full" />
  {
    caption && (
      <figcaption class="border-t border-hairline px-4 py-3 font-mono text-xs text-plomo-400">{caption}</figcaption>
    )
  }
</figure>
