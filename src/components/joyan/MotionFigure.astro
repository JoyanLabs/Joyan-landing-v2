---
import { cn } from '~/lib/utils';

export interface Props {
  /**
   * Static poster. Kept in the DOM underneath the film rather than passed as
   * the video's `poster`, so the hero degrades through the same path as every
   * other figure: no JS, no motion preference, or a slow connection all land
   * on this image instead of on nothing.
   */
  src: string;
  /** Seamlessly looping film, H.264 fallback. */
  videoSrc: string;
  /**
   * AV1 source, listed first. The browser downloads the first source it can
   * decode and never requests the rest, so this is a quality tier rather than
   * a double cost: AV1 is delivered one resolution higher at a smaller byte
   * count than the H.264 fallback it sits in front of.
   */
  videoSrcAv1?: string;
  /** MIME type including the codec parameter browsers match on. */
  videoTypeAv1?: string;
  /** Empty for decorative art (the hero figure). */
  alt?: string;
  /** Intrinsic poster dimensions reserve layout and avoid CLS. */
  width: number;
  height: number;
  /** Intrinsic film dimensions; the film is authored at the same aspect. */
  videoWidth: number;
  videoHeight: number;
  class?: string;
}

const {
  src,
  videoSrc,
  videoSrcAv1,
  videoTypeAv1 = 'video/mp4; codecs="av01.0.05M.08"',
  alt = '',
  width,
  height,
  videoWidth,
  videoHeight,
  class: className,
} = Astro.props;
---

<figure class={cn('relative overflow-hidden bg-ink-950', className)}>
  <div class="h-full w-full [&>img]:h-full [&>img]:w-full [&>img]:object-cover">
    <img src={src} alt={alt} width={width} height={height} class="block h-auto w-full" />
  </div>
  <video
    class="joyan-film absolute inset-0 h-full w-full object-cover"
    data-hero-film
    width={videoWidth}
    height={videoHeight}
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
    tabindex="-1"
  >
    {videoSrcAv1 && <source src={videoSrcAv1} type={videoTypeAv1} />}
    <source src={videoSrc} type="video/mp4" />
  </video>
</figure>
