---
/**
 * Section 04 — "Una cooperativa, una comunidad".
 *
 * A flat ring of identical peers. Every node is the same size and none sits
 * above the others, which is the claim: there is no head. The chords are drawn
 * faintly because the point is that knowledge travels sideways, not down a
 * spine. The small amber mark at the centre is the shared thing they hold —
 * one shared wordmark-height of amber, not a boss.
 */
export interface Props {
  alt: string;
  class?: string;
}
const { alt, class: className } = Astro.props;

const PEERS = 8;
const R = 112;
const CX = 360;
const CY = 158;

const peers = Array.from({ length: PEERS }, (_, i) => {
  const a = (-90 + i * (360 / PEERS)) * (Math.PI / 180);
  return {
    x: +(CX + Math.cos(a) * R).toFixed(1),
    y: +(CY + Math.sin(a) * R).toFixed(1),
    // Peer 4 is lit: the one currently contributing. Exactly one, as the
    // MAGI diagram already does.
    lit: i === 4,
  };
});

/** Chords between peers two apart — the sideways knowledge paths. */
const chords = Array.from({ length: PEERS }, (_, i) => {
  const p = peers[i];
  const q = peers[(i + 3) % PEERS];
  return `M${p.x} ${p.y}L${q.x} ${q.y}`;
});
---

<figure class:list={['border border-hairline bg-ink-900', className]}>
  <svg
    viewBox="0 0 720 366"
    class="block h-auto w-full"
    role="img"
    aria-label={alt}
    xmlns="http://www.w3.org/2000/svg"
  >
    <g fill="none" stroke="rgba(255,255,255,0.13)" stroke-width="1" vector-effect="non-scaling-stroke">
      {chords.map((d) => <path d={d} />)}
    </g>

    <circle cx={CX} cy={CY} r={R} fill="none" stroke="rgba(255,255,255,0.16)" stroke-width="1" vector-effect="non-scaling-stroke" />
    <circle cx={CX} cy={CY} r={R - 46} fill="none" stroke="rgba(255,255,255,0.08)" stroke-dasharray="3 5" stroke-width="1" vector-effect="non-scaling-stroke" />

    <g fill="none" stroke-width="1.5" vector-effect="non-scaling-stroke">
      {
        peers.map((p) => (
          <circle
            cx={p.x}
            cy={p.y}
            r={p.lit ? 15 : 10}
            fill={p.lit ? '#ffb000' : '#121214'}
            stroke={p.lit ? '#ffb000' : 'rgba(255,255,255,0.5)'}
          />
        ))
      }
    </g>

    <!-- The shared mark. Deliberately small: it is what they share, not a
         node that outranks them. -->
    <rect x={CX - 13} y={CY - 13} width="26" height="26" fill="#ffb000" fill-opacity="0.16" stroke="#ffb000" stroke-width="1" vector-effect="non-scaling-stroke" />

    <g font-family="'JetBrains Mono Variable', monospace" font-size="16" letter-spacing="2.2" text-anchor="middle" fill="#8a8a90">
      <text x={CX} y="310">APORTA</text>
      <text x={CX} y="336">COMPARTE</text>
      <text x={CX} y="362" fill="#e8e6e1">SIN JERARQUÍA</text>
    </g>
  </svg>
</figure>
